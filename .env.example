# Purl Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Server
PURL_PORT=3000
PURL_HOST=0.0.0.0
# Prefork worker processes
PURL_WORKERS=4

# Security
# Comma-separated CIDRs/IPs allowed to set X-Forwarded-For.
# Empty = never trust the header, always use the socket peer address.
# Set this to your nginx / ingress network, e.g. 10.42.0.0/16
PURL_TRUSTED_PROXIES=
# CSRF protection on mutating endpoints (1 = on). Only disable for debugging.
PURL_CSRF_ENABLED=1

# Ingest durability
# 1 = wait for ClickHouse to confirm the write before returning 2xx.
# 0 = fire-and-forget (faster, but an accepted log can still be lost).
PURL_INGEST_DURABLE=0
# Max buffered log lines before the ingest endpoint applies backpressure (503).
PURL_INGEST_BUFFER_MAX=10000

# Pipeline regex safety (ReDoS guard)
PURL_PIPELINE_REGEX_TIMEOUT_MS=250
PURL_PIPELINE_REGEX_MAX_LENGTH=512

# Storage
PURL_STORAGE_TYPE=clickhouse

# ClickHouse
PURL_CLICKHOUSE_HOST=clickhouse
PURL_CLICKHOUSE_PORT=8123
PURL_CLICKHOUSE_DATABASE=purl
PURL_CLICKHOUSE_USER=purl
# Generate with: openssl rand -base64 24
PURL_CLICKHOUSE_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# Authentication (comma-separated API keys)
PURL_AUTH_ENABLED=1
# Generate with: openssl rand -base64 32
PURL_API_KEYS=CHANGE_ME_GENERATE_SECURE_API_KEY

# Retention
# The only retention control. It is bounded purely by your own ClickHouse
# storage.
PURL_RETENTION_DAYS=30

# Backup Schedule
# PURL_BACKUP_SCHEDULE_ENABLED=0
# PURL_BACKUP_SCHEDULE_INTERVAL_HOURS=24
# PURL_BACKUP_RETENTION_DAYS=30
# PURL_BACKUP_DIR=/app/backups
# max_execution_time (seconds) for backup export/restore queries. Raise it for
# very large tables; the export streams to disk, so only time is the limit.
# PURL_BACKUP_QUERY_TIMEOUT=3600

# S3 Backup Upload (optional)
# Credentials are also used to DOWNLOAD (restore) and DELETE backup objects,
# so they must stay configured for as long as any backup lives in the bucket.
# PURL_BACKUP_S3_ENABLED=0
# PURL_BACKUP_S3_BUCKET=my-purl-backups
# PURL_BACKUP_S3_REGION=us-east-1
# PURL_BACKUP_S3_PREFIX=purl-backups/
# PURL_BACKUP_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Prometheus metrics (/api/metrics)
# Request/error/latency/ingest counters are stored in the shared counter store.
# WITHOUT PURL_REDIS_URL they are per-worker, so a prefork server exports only
# one worker's slice — check purl_metrics_shared (1 = fleet-wide) to confirm.
# Counter key lifetime in seconds (default 604800 = 7 days).
# PURL_METRICS_TTL=604800

# Alerting — Telegram (optional)
# These override whatever is saved in settings.json; once set here, the value
# is env-locked and the Settings UI cannot change it.
# PURL_TELEGRAM_BOT_TOKEN=
# PURL_TELEGRAM_CHAT_ID=
# Forum topic (message_thread_id) to post alerts into, for groups with Topics
# enabled. A positive integer — copy it from the topic's message link
# (t.me/c/<chat>/<THREAD_ID>/<message>). Empty = the group's General topic.
# Telegram rejects the WHOLE sendMessage on a bad id, so a wrong value here
# means no alerts at all rather than alerts in the wrong place.
# PURL_TELEGRAM_THREAD_ID=

# Live tail (WebSocket) cross-process delivery
# With one container, tailed batches cross the prefork workers through this
# spool file; it defaults to live-tail.spool beside settings.json. Point it at
# a tmpfs/emptyDir on a high-ingest host to keep the appends off the config
# volume. It must be writable by the app user or live tail silently degrades to
# worker-local (one "spool disabled" warning in the log, nothing in the UI).
# PURL_BROADCAST_SPOOL=/app/config/live-tail.spool
# MORE THAN ONE PURL CONTAINER: a spool file only reaches workers that share a
# filesystem. Set PURL_REDIS_URL or live tail shows one container's logs only.
# PURL_REDIS_URL=redis://redis:6379

# Vector (for log collector)
# PURL_URL=http://purl:3000
# PURL_API_KEY=same_as_above

# AI assistant: max LLM calls (query/analyze/explain) per user per 60s.
# Callers without a session are counted by client IP. 0 disables the limit.
# Without PURL_REDIS_URL each worker counts on its own, so the effective limit
# is up to (workers x limit). Behind a reverse proxy set PURL_TRUSTED_PROXIES,
# or every caller shares the proxy's IP budget.
# PURL_AI_RATE_LIMIT=20
