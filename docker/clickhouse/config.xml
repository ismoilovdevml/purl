<?xml version="1.0"?>
<!-- ClickHouse server config for docker-compose (mounted as
     config.d/custom.xml). install.sh downloads a copy of this file.

     Two parts:
       1. compose-only settings (listen, console logging, compression, ...)
       2. the Purl SMALL PROFILE (#108): memory, caches, background pools,
          system log tables. Its source of truth is
          chart/files/clickhouse/purl-small.xml, which the Helm chart mounts.
          Every value there must appear here unchanged — `make helm-lint`
          runs scripts/check_clickhouse_profile.py and fails on any drift.
          Change a profile value in BOTH files.
-->
<clickhouse>
    <!-- =========================================================== -->
    <!-- 1. Compose-only settings                                     -->
    <!-- =========================================================== -->

    <!-- Network - Force IPv4 only -->
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>

    <!-- Logging: console for `docker logs`, errors also to a file.
         <level> is part of the profile below. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
    </logger>

    <!-- Compression - LZ4 is fastest for logs -->
    <compression>
        <case>
            <method>lz4</method>
        </case>
    </compression>

    <max_connections>100</max_connections>

    <!-- Single node - disable interserver -->
    <interserver_http_host>127.0.0.1</interserver_http_host>

    <!-- HTTP Server Settings - reduce connection errors -->
    <http_server_default_response><![CDATA[<html><body><h1>Ok.</h1></body></html>]]></http_server_default_response>
    <keep_alive_timeout>10</keep_alive_timeout>

    <!-- Skip check for user-level settings at top level -->
    <skip_check_for_incorrect_settings>1</skip_check_for_incorrect_settings>

    <!-- =========================================================== -->
    <!-- 2. Purl small profile — mirror of                            -->
    <!--    chart/files/clickhouse/purl-small.xml (see header)        -->
    <!-- =========================================================== -->

    <!-- Headroom inside the container limit: jemalloc retained pages and
         the binary's resident text are outside the memory tracker. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- Caches. Server defaults are sized for dedicated hosts (uncompressed
         8 GiB, mark / primary index 5 GiB). Log search reads each block once,
         so caching decompressed blocks buys nothing; 0 disables it even when
         a client sends use_uncompressed_cache=1. -->
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <mark_cache_size>67108864</mark_cache_size>                 <!-- 64 MiB -->
    <primary_index_cache_size>33554432</primary_index_cache_size> <!-- 32 MiB -->
    <index_mark_cache_size>16777216</index_mark_cache_size>       <!-- 16 MiB -->
    <index_uncompressed_cache_size>0</index_uncompressed_cache_size>
    <query_condition_cache_size>16777216</query_condition_cache_size>
    <mmap_cache_size>64</mmap_cache_size>
    <compiled_expression_cache_size>16777216</compiled_expression_cache_size>
    <compiled_expression_cache_elements_size>1000</compiled_expression_cache_elements_size>

    <!-- Background pools: one small node, one hot table. -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <merges_mutations_memory_usage_to_ram_ratio>0.25</merges_mutations_memory_usage_to_ram_ratio>
    <async_insert_threads>2</async_insert_threads>
    <max_concurrent_queries>64</max_concurrent_queries>

    <merge_tree>
        <!-- Profile values. Must stay <= background_pool_size *
             concurrency_ratio (8). -->
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
        <!-- Wide log rows (message/raw/meta): smaller merge blocks keep a
             merge's working set down. -->
        <merge_max_block_size>2048</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>5368709120</max_bytes_to_merge_at_max_space_in_pool>
        <!-- Merge wide tables column by column at any row count. A Horizontal
             merge opens ~2 MiB of buffers per column stream, so a leftover
             1531-column system.metric_log from a pre-profile install asked
             for ~1 GiB per merge, failed at the 1.2 GiB cap, retried every
             few seconds, and made unrelated inserts fail with code 241. -->
        <vertical_merge_algorithm_min_rows_to_activate>1</vertical_merge_algorithm_min_rows_to_activate>

        <!-- Compose-only MergeTree settings -->
        <max_suspicious_broken_parts>5</max_suspicious_broken_parts>
        <parts_to_delay_insert>150</parts_to_delay_insert>
        <parts_to_throw_insert>300</parts_to_throw_insert>
        <max_replicated_merges_in_queue>16</max_replicated_merges_in_queue>
        <index_granularity>8192</index_granularity>
        <min_rows_for_wide_part>100000</min_rows_for_wide_part>
        <min_bytes_for_wide_part>10485760</min_bytes_for_wide_part>
    </merge_tree>

    <!-- System log tables: keep query_log (Purl's own diagnostics read it)
         and part_log, bound them with a TTL; drop the rest. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <crash_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <zookeeper_log remove="1"/>
    <transactions_info_log remove="1"/>
    <filesystem_cache_log remove="1"/>
</clickhouse>
