<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <!-- Default profile. The settings between the SMALL PROFILE markers
             mirror chart/files/clickhouse/purl-small-profile.xml (#108), the
             source of truth the Helm chart mounts; `make helm-lint` runs
             scripts/check_clickhouse_profile.py and fails on any drift.
             Change a value in BOTH files. -->
        <default>
            <!-- SMALL PROFILE begin -->
            <!-- No single query may take more than 256 MiB; above that it
                 spills (sort / group by) or fails ALONE with code 241
                 instead of pushing the whole server over its limit. -->
            <max_memory_usage>268435456</max_memory_usage>
            <max_bytes_before_external_sort>67108864</max_bytes_before_external_sort>
            <max_bytes_before_external_group_by>67108864</max_bytes_before_external_group_by>
            <max_threads>2</max_threads>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <!-- Lazy materialisation (read heavy columns only for the rows
                 that survive ORDER BY ... LIMIT) is capped at LIMIT 100 by
                 default; Purl pages are 500-2000. -->
            <query_plan_max_limit_for_lazy_materialization>10000</query_plan_max_limit_for_lazy_materialization>
            <max_execution_time>30</max_execution_time>
            <async_insert_max_data_size>4194304</async_insert_max_data_size>
            <!-- SMALL PROFILE end -->

            <!-- Compose-only settings below. -->

            <!-- Disable query logging (reduces noise) -->
            <log_queries>0</log_queries>
            <log_queries_min_type>EXCEPTION_WHILE_PROCESSING</log_queries_min_type>

            <timeout_before_checking_execution_speed>10</timeout_before_checking_execution_speed>

            <!-- Row/byte limits -->
            <max_rows_to_read>100000000</max_rows_to_read>
            <max_bytes_to_read>10000000000</max_bytes_to_read>
            <max_result_rows>100000</max_result_rows>
            <max_result_bytes>100000000</max_result_bytes>

            <!-- Load balancing -->
            <load_balancing>random</load_balancing>

            <optimize_read_in_order>1</optimize_read_in_order>

            <!-- Insert settings for high-throughput async inserts.
                 wait_for_async_insert defaults to 1 (safe-by-default): a client
                 that does not override it gets a durable acknowledgement rather
                 than a silent at-most-once 200. Purl controls this per request:
                 the durable ingest path sends wait_for_async_insert=1 and the
                 legacy fast path explicitly sends wait_for_async_insert=0.
                 See Purl::Storage::ClickHouse::_async_insert_settings. -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_busy_timeout_ms>1000</async_insert_busy_timeout_ms>
        </default>

        <!-- Read-only profile -->
        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>1000000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
        </readonly>
    </profiles>

    <users>
        <!-- The `default` user is deliberately NOT declared here.
             The clickhouse-server image entrypoint owns it: because
             docker-compose.yml sets CLICKHOUSE_USER/CLICKHOUSE_PASSWORD/
             CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT, the entrypoint writes
             users.d/default-user.xml containing

               <default remove="remove"/>
               <default>...<password><![CDATA[$CLICKHOUSE_PASSWORD]]></password>...</default>

             That file sorts AFTER this one (custom.xml), so a <default> block
             here is deleted by remove="remove" and never took effect — the
             password install.sh substitutes below was silently ignored for
             this user, leaving `default` on whatever CLICKHOUSE_PASSWORD held
             (EMPTY before that variable was added to docker-compose.yml).

             Re-adding <default> in a users.d file that sorts after
             default-user.xml is worse, not better: ClickHouse appends text to
             the entrypoint's CDATA password node instead of replacing it, so
             the effective password silently becomes the value twice. See the
             long note in web/e2e/stack/users-e2e.xml (issue #70).

             To change `default`'s password, set PURL_CLICKHOUSE_PASSWORD in
             .env — docker-compose.yml passes it through as CLICKHOUSE_PASSWORD.

             Purl application user -->
        <purl>
            <password>CHANGE_ME_GENERATE_SECURE_PASSWORD</password>
            <networks>
                <!-- Restrict to Docker internal network only -->
                <ip>172.16.0.0/12</ip>
                <ip>10.0.0.0/8</ip>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </purl>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
