# Credentials for the ephemeral Playwright e2e stack.
#
# These are TEST-ONLY values for a throwaway container that is torn down at the
# end of the run. They are deliberately committed so that the docker compose
# stack and the Playwright specs read the SAME values from ONE file — every
# previous attempt at "just hardcode it in both places" drifted.
#
# Consumed by:
#   - web/e2e/stack/up.sh        (docker compose --env-file)
#   - web/e2e/fixtures/purl.js   (loadStackEnv)
#
# Never point a real deployment at this file.

PURL_IMAGE_TAG=e2e-local
PURL_PORT=3000
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000

# Auth must be ON: a fresh container starts a 14-day trial (= Pro features), and
# the dashboard only renders LoginPage when the plan is paid/trial. With auth
# off, every login-dependent spec would silently test a different app.
PURL_AUTH_ENABLED=1

# Must not be one of the weak passwords Server.pm warns about, and must not be
# literally "admin" — that triggers the forced password-change screen and every
# spec would stall on it.
PURL_ADMIN_PASSWORD=e2e-Adm1n-Pass-9f3a

PURL_API_KEYS=e2e-ingest-key-9f3a2b7c
PURL_SESSION_SECRET=e2e0000000000000000000000000000000000000000000000000000000009f3a

PURL_CLICKHOUSE_USER=purl
PURL_CLICKHOUSE_PASSWORD=e2e-ch-Pass-9f3a2b7c
PURL_RETENTION_DAYS=30
