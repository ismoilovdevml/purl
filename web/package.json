    "test:e2e:install": "playwright install --with-deps chromium",
    "e2e:stack:up": "bash e2e/stack/up.sh",
    "e2e:stack:down": "bash e2e/stack/down.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.1",
    "vite": "^8.3.0"
  }
}
