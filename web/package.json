{
  "name": "purl-dashboard",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ playwright.config.js",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
